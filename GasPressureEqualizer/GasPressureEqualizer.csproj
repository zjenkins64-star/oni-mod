<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net48</TargetFramework>

		<LangVersion>latest</LangVersion>
		<Nullable>disable</Nullable>

		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<AssemblyName>GasPressureEqualizer</AssemblyName>

		<!-- Helps avoid weird dependency output issues -->
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

		<!-- Optional but helpful for debugging -->
		<DebugType>portable</DebugType>
		<DebugSymbols>true</DebugSymbols>
	</PropertyGroup>

	<!-- ===================== -->
	<!-- COPY BUILD OUTPUT TO ONI -->
	<!-- ===================== -->
	<Target Name="CopyToONIModFolder" AfterTargets="Build">

		<PropertyGroup>
			<ONIModPath>C:\Users\zjenk\OneDrive\Documents\Klei\OxygenNotIncluded\mods\Local\GasPressureEqualizer\</ONIModPath>
		</PropertyGroup>

		<MakeDir Directories="$(ONIModPath)" />

		<Copy SourceFiles="$(TargetPath)"
			  DestinationFolder="$(ONIModPath)"
			  SkipUnchangedFiles="true" />

		<Copy SourceFiles="$(ProjectDir)mod_info.yaml"
			  DestinationFolder="$(ONIModPath)"
			  SkipUnchangedFiles="true" />

		<Copy SourceFiles="$(ProjectDir)mod.yaml"
			  DestinationFolder="$(ONIModPath)"
			  SkipUnchangedFiles="true" />

		<!-- Copy custom kanim assets, preserving subfolder structure. -->
		<ItemGroup>
			<AnimAssets Include="$(ProjectDir)anim\**\*"
			            Exclude="$(ProjectDir)anim\**\.dumped" />
		</ItemGroup>
		<Copy SourceFiles="@(AnimAssets)"
			  DestinationFiles="@(AnimAssets->'$(ONIModPath)anim\%(RecursiveDir)%(Filename)%(Extension)')"
			  SkipUnchangedFiles="true" />

	</Target>

